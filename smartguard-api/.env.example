# SmartGuard Agent API — Environment Variables
# Copy this file to .env and fill in your real keys. NEVER commit .env.

# LLM (OpenAI-compatible — Google Gemini 2.0 Flash recommended)
LLM_API_KEY=your-gemini-api-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Opik (Comet ML) — tracing & prompt versioning
OPIK_API_KEY=your-opik-api-key
OPIK_PROJECT=smartguard-api

# MCP server endpoint
MCP_SERVER=http://localhost:9090/mcp

# Disable nest asyncio (recommended for FastAPI + async MCP client)
DISABLE_NEST_ASYNCIO=True
